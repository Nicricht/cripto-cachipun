{
  "name": "cripto-cachipun",
  "version": "1.0.0",
  "private": true,
  "description": "Juego Piedra, Papel o Tijera con apuestas en Ether y mecanismo Commit-Reveal",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
