    "build:web": "vite build --root frontend",
    "test:web": "node --test frontend/src/commitment.test.mjs"
  },
  "dependencies": {
    "ethers": "^6.15.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.17",
    "vite": "^6.4.1"
  }
}
